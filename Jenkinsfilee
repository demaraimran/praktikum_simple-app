pipeline {
    agent any
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    sh 'docker build -t dewantirani/simple-app:${env.BUILD_NUMBER} .'
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                    script {
                        sh "echo %DOCKER_PASS% | docker login -u %DOCKER_USER% --password-stdin"
                        sh "docker push dewantirani/simple-app:${env.BUILD_NUMBER}"
                        sh "docker tag dewantirani/simple-app:${env.BUILD_NUMBER} dewantirani/simple-app:latest"
                        sh "docker push dewantirani/simple-app:latest"
                    }
                }
            }
        }
    }
}
