pipeline {
    agent any
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    docker.image('simple-app:${env.BUILD_NUMBER}').buildWithArgs(".")
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        def customImage = docker.image('demaraimran/simple-app:${env.BUILD_NUMBER}')
                        customImage.push()
                        customImage.push('latest')
                    }
                }
            }
        }
    }
}
