pipeline {
    agent any
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    bat 'docker build -t dewantirani/simple-app:%BUILD_NUMBER% .'
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                withDockerRegistry(credentialsId: 'dockerhub-credentials', toolName: 'default') {
                    script {
                        bat 'docker tag dewantirani/simple-app:%BUILD_NUMBER% dewantirani/simple-app:latest'
                        bat 'docker push dewantirani/simple-app:%BUILD_NUMBER%'
                        bat 'docker push dewantirani/simple-app:latest'
                    }
                }
            }
        }
    }
}
