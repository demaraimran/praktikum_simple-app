pipeline {
    agent any
    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    // Gunakan tanda kutip ganda (") agar interpolasi ${env.BUILD_NUMBER} terbaca dengan benar
                    app = docker.build("demaraimran/simple-app:${env.BUILD_NUMBER}")
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        app.push("${env.BUILD_NUMBER}")
                        app.push("latest")
                    }
                }
            }
        }
    }
}
